cat >>"$prefix" <<"EOF"
<script>
document.documentElement.classList.add('mermaid-loading');

const mermaidHeightKey = 'markd:mermaid-heights:' +
  document.querySelector('meta[name="markd-document"]').content;
let mermaidHeights = [];
try {
  const cached = JSON.parse(sessionStorage.getItem(mermaidHeightKey));
  if (cached?.width === window.innerWidth && Array.isArray(cached.heights)) {
    mermaidHeights = cached.heights;
  }
} catch (error) {
  // Storage may be unavailable, or a previous cache entry may be invalid.
}

function reserveMermaidHeights() {
  document.querySelectorAll('pre > code.language-mermaid').forEach((code, i) => {
    const height = mermaidHeights[i];
    if (Number.isFinite(height) && height > 0) {
      const pre = code.parentElement;
      pre.classList.add('mermaid-placeholder');
      pre.style.setProperty('--mermaid-height', height + 'px');
    }
  });
}

function rememberMermaidHeights() {
  const heights = Array.from(
    document.querySelectorAll('.mermaid, pre:has(> code.language-mermaid)'),
    el => el.getBoundingClientRect().height
  );
  try {
    sessionStorage.setItem(mermaidHeightKey, JSON.stringify({ width: window.innerWidth, heights }));
  } catch (error) {
    // Rendering still works when storage is disabled or full.
  }
}

// Reserve space as the parser adds code blocks, before the first paint.
const mermaidPlaceholderObserver = new MutationObserver(reserveMermaidHeights);
mermaidPlaceholderObserver.observe(document.documentElement, { childList: true, subtree: true });

document.addEventListener('DOMContentLoaded', async function() {
  mermaidPlaceholderObserver.disconnect();
  reserveMermaidHeights();
  try {
    // Preserve diagram source across the escaped-dollar workaround below.
    const mermaidSources = Array.from(
      document.querySelectorAll('pre > code.language-mermaid'), el => el.textContent
    );

    // HACK: https://github.com/KaTeX/KaTeX/issues/437#issuecomment-1147314526
    document.body.innerHTML = document.body.innerHTML.replace(/\\\$/g, '<span>$</span>');
    renderMathInElement(document.body, {
      delimiters: [
        {left: '$$', right: '$$', display: true},
        {left: '$', right: '$', display: false},
        {left: '\\[', right: '\\]', display: true},
        {left: '\\(', right: '\\)', display: false},
      ],
      supportEscapedSpecialCharsInText: true,
      throwOnError: false
    });

    // ```math
    document.querySelectorAll("pre:has(> code.language-math)").forEach((el) => {
      const tex = el.innerText;
      katex.render(tex, el, {
        throwOnError: false,
        displayMode: true
      });
      el.classList.add("katex-display");
    });

    const mermaidBlocks = Array.from(document.querySelectorAll('pre > code.language-mermaid'));
    mermaidBlocks.forEach((el, i) => {
      el.textContent = mermaidSources[i];
      el.classList.add('nohighlight');
    });
    hljs.highlightAll();

    if (mermaidBlocks.length) {
      try {
        const { default: mermaid } = await import('https://cdn.jsdelivr.net/npm/mermaid@12.2.0/dist/mermaid.esm.min.mjs');
        mermaid.initialize({ startOnLoad: false, securityLevel: 'strict', suppressErrorRendering: true });
        for (const code of mermaidBlocks) {
          const pre = code.parentElement;
          const diagram = document.createElement('div');
          diagram.className = 'mermaid';
          if (pre.classList.contains('mermaid-placeholder')) {
            diagram.classList.add('mermaid-placeholder');
            diagram.style.setProperty('--mermaid-height', pre.style.getPropertyValue('--mermaid-height'));
          }
          diagram.textContent = code.textContent;
          pre.replaceWith(diagram);
          try {
            await mermaid.run({ nodes: [diagram] });
          } catch (error) {
            // Keep invalid diagrams readable while editing, and render the rest.
            diagram.replaceWith(pre);
            console.error('Could not render Mermaid diagram:', error);
          }
        }
      } catch (error) {
        console.error('Could not load Mermaid:', error);
      }
    }
  } finally {
    // Also reveal source if rendering or a CDN dependency fails.
    document.documentElement.classList.remove('mermaid-loading');
    rememberMermaidHeights();
    const diagrams = document.querySelectorAll('.mermaid, pre:has(> code.language-mermaid)');
    const resizeObserver = new ResizeObserver(rememberMermaidHeights);
    diagrams.forEach(el => resizeObserver.observe(el));
    window.addEventListener('resize', rememberMermaidHeights);
  }
});
EOF

